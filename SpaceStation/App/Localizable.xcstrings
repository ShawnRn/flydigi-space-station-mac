    },
    "Accessibility permission granted — mappings to the keyboard and mouse are active while the app runs.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de Acessibilidade concedida — os mapeamentos para teclado e mouse ficam ativos enquanto o app roda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授予辅助功能权限——应用运行期间键盘与鼠标映射保持生效。"
          }
        }
      }
    },
    "Accessibility permission not granted — mappings to the keyboard and mouse do nothing yet.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de Acessibilidade não concedida — os mapeamentos para teclado e mouse ainda não fazem nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授予辅助功能权限——键盘与鼠标映射暂不会生效。"
          }
        }
      }
    },
