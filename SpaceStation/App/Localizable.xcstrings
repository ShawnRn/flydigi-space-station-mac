          }
        }
      }
    },
    "Mappings, sticks, triggers, gyro, vibration and macros go back to their defaults in the editor. Nothing is written to the controller until you Apply.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeamentos, analógicos, gatilhos, giroscópio, vibração e macros voltam ao padrão no editor. Nada é gravado no controle até você Aplicar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器中的按键映射、摇杆、扳机、体感、震动与宏设置将全部恢复默认值。在点击“应用”前不会写入手柄。"
          }
        }
      }
    },
