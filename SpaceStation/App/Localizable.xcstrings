            "state": "translated",
            "value": "行程"
          }
        }
      }
    },
    "Support the project": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie o projeto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持项目"
          }
        }
      }
    },
    "Swap A↔B / X↔Y": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互换 A↔B / X↔Y"
          }
        }
      }
    },
    "Swap A↔B / X↔Y (Switch layout)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互换 A↔B / X↔Y（Switch 布局）"
          }
        }
      }
    },
    "Swap A↔B and X↔Y for Nintendo Switch layout, or switch to the NS slots in the top bar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可一键互换 A↔B / X↔Y 为任天堂 Switch 布局，或在右上角切换至 NS 槽位单独配置。"
          }
        }
      }
    },
    "Switch (NS) mode slots": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch (NS) 模式专用槽位"
          }
        }
      }
    },
    "Switch between PC slots (1–4) and Nintendo Switch mode slots (NS 1–4)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 PC 模式槽位（配置 1–4）与 Nintendo Switch 模式专用槽位（NS 1–4）"
          }
        }
      }
    },
    "Switch face layout": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch (NS) 键位布局"
          }
        }
      }
    },
    "Switch to DInput": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar para DInput"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切至 DInput"
          }
        }
      }
    },
    "Switch to DInput mode": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar para modo DInput"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换为 DInput 模式"
          }
        }
      }
    },
    "Switch to XInput": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar para XInput"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切至 XInput"
          }
        }
      }
    },
    "Switch to XInput mode": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar para modo XInput"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换为 XInput 模式"
          }
        }
      }
    },
    "Switching back to XInput…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltando para XInput…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在切回 XInput 模式…"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "Takes effect after restarting the app": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale após reiniciar o app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启应用后生效"
          }
        }
      }
    },
    "Tap (press + release)": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque (pressionar + soltar)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按（按下并松开）"
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Testar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试"
          }
        }
      }
    },
    "Test vibration": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Testar vibração"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试震动"
          }
        }
      }
    },
    "The Apex 4 keeps a separate set of four profiles for Switch mode (slots 5–8 inside the controller). This copies the profile in the editor, and its lighting, into the matching Switch slot — keyboard/mouse mappings are dropped, as Space Station does.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apex 4 guarda um segundo conjunto de quatro perfis para o modo Switch (slots 5 a 8 dentro do controle). Isto copia o perfil do editor, com a iluminação, para o slot Switch correspondente — mapeamentos de teclado/mouse são removidos, como o Space Station faz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "八爪鱼 4 为 Switch 模式单独保留了一组 4 个板载槽位（内部槽位 5–8）。此操作会把当前编辑器中的配置及灯光写入对应的 Switch 槽位（按空间站规则自动剔除键鼠映射）。"
          }
        }
      }
    },
    "The animation each Apex 4 edition ships with on its screen. Yours is marked; the others are the special editions'.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A animação com que cada edição do Apex 4 sai da fábrica no visor. A sua está marcada; as outras são das edições especiais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各版本八爪鱼 4 出厂自带的屏幕动画。带有标记的是当前设备对应的默认动画。"
          }
        }
      }
    },
    "The app logs to the unified system log (Console.app, subsystem com.uiltonlopes.spacestation). Export the last hours to a text file to attach to a bug report.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app registra no log unificado do sistema (Console, subsistema com.uiltonlopes.spacestation). Exporte as últimas horas para um arquivo de texto para anexar a um relato de bug."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用日志会写入 macOS 统一系统日志（控制台.app，子系统 com.uiltonlopes.spacestation）。可导出最近几小时日志以便反馈排查问题。"
          }
        }
      }
    },
    "The controller cannot be read back; this is what was last sent from here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não permite ler o visor; isto é o que foi enviado por último daqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄不支持回读屏幕动画，此处显示的是从这台 Mac 最近一次发送的记录。"
          }
        }
      }
    },
    "The controller confirmed the image (result 0).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle confirmou a imagem (resultado 0)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄已确认接收动画（返回码 0）。"
          }
        }
      }
    },
    "The controller did not accept the command.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não aceitou o comando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄拒绝了该指令。"
          }
        }
      }
    },
    "The controller did not answer in time. Press refresh to try again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não respondeu a tempo. Clique em atualizar para tentar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄响应超时。请点击“刷新”重试。"
          }
        }
      }
    },
    "The controller did not answer in time. Turn it on or reconnect the cable — it shows up by itself.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não respondeu a tempo. Ligue-o ou reconecte o cabo — ele aparece sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄响应超时。请确认手柄已开机或重新插拔数据线，设备会自动重连。"
          }
        }
      }
    },
    "The controller did not come back within %lld s. Unplug and replug the cable, then check its firmware version.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não voltou em %lld s. Desconecte e reconecte o cabo e confira a versão do firmware."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄未在 %lld 秒内恢复上线。请重新插拔数据线后检查固件版本。"
          }
        }
      }
    },
    "The controller does not report movement while calibrating — follow the timer.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle não reporta movimento enquanto calibra — siga o cronômetro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准期间手柄不会向上位机发送实时数值——请跟随计时器节奏操作。"
          }
        }
      }
    },
    "The controller still reports %@ — the update did not take. Try again with the cable firmly connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄仍报告固件版本 %@ —— 更新未生效。请确保数据线连接稳固后重试。"
          }
        }
      }
    },
    "The controller stops sending this button to games; Space Station for Mac turns it into the keyboard or mouse action above while it is running. Stored on this Mac per profile.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle para de enviar este botão aos jogos; o Space Station for Mac o transforma na ação de teclado ou mouse acima enquanto estiver aberto. Guardado neste Mac por perfil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄将不再向游戏发送此按键的原始信号；在 Space Station 运行期间，应用会将其转换为上方设定的键鼠动作（按配置保存于本 Mac）。"
          }
        }
      }
    },
    "The controller's update interface did not appear.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A interface de atualização do controle não apareceu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到手柄的固件升级接口。"
          }
        }
      }
    },
    "The helper is not installed. Install it in Settings › Privileged helper, or switch the controller to DInput.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O helper não está instalado. Instale em Ajustes › Helper privilegiado ou mude o controle para DInput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特权辅助程序尚未安装。请前往“设置 › 特权辅助程序”安装，或将手柄切换至 DInput 模式。"
          }
        }
      }
    },
    "The lighting did not apply completely. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光设置未完全应用成功，请重试。"
          }
        }
      }
    },
    "The profile could not be converted.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível converter o perfil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转换该配置文件。"
          }
        }
      }
    },
    "The reply is not a controller profile.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta não é um perfil de controle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的数据不是有效的手柄配置。"
          }
        }
      }
    },
    "The test needs XInput mode.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste precisa do modo XInput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此测试需要在 XInput 模式下进行。"
          }
        }
      }
    },
    "The trigger gets hard to push past this point, like a shorter trigger.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho fica duro a partir deste ponto, como um gatilho mais curto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扳机超过此位置后阻力骤增，等效缩短按压行程。"
          }
        }
      }
    },
    "The trigger gets hard to push past this point, like a shorter trigger. Levels 1–3 are the pad's own menu presets.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho fica duro a partir deste ponto, como um gatilho mais curto. Os níveis 1 a 3 são os presets do menu do controle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扳机超过此位置后阻力骤增，等效缩短行程。1–3 挡对应手柄自带屏幕菜单预设。"
          }
        }
      }
    },
    "The trigger reports a full press once it reaches the breakthrough — the shot fires at the wall.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho reporta pressão total ao chegar no rompimento — o tiro sai na parede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扳机按破阻尼墙的瞬间即触发 100 % 满行程——开火干脆利落。"
          }
        }
      }
    },
    "The trigger reports a full press once it reaches the start position.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho reporta pressão total ao chegar na posição inicial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扳机抵达起始位置时立即触发 100 % 满行程输入。"
          }
        }
      }
    },
    "The trigger vibrates together with the grip motors (game rumble).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gatilho vibra junto com os motores da empunhadura (vibração do jogo)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扳机马达随握把震动（游戏内震动）同步共振。"
          }
        }
      }
    },
    "The update runs from this Mac the same way Space Station does it: the controller is put in update mode, the image is written over USB, and it restarts with the new firmware. Profiles, lighting and the screen animation are kept.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização roda deste Mac do mesmo jeito que o Space Station faz: o controle entra em modo de atualização, a imagem é gravada pelo USB e ele reinicia com o novo firmware. Perfis, luz e a animação da tela são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新流程与官方空间站一致：手柄切入升级模式后通过 USB 写入固件并自动重启。原有板载配置、灯光与屏幕动画均会保留。"
          }
        }
      }
    },
    "The values the Apex 4 itself uses for this mode in its screen menu": {
      "localizations": {
