    "Name": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Needed for anything that has to happen while you are not looking at the app — per-game trigger presets, the menu bar status. You can close the window; the app keeps running in the menu bar.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o que precisa acontecer sem o app na frente — presets de gatilho por jogo, status na barra de menus. Pode fechar a janela; o app continua rodando na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在你切出窗口后继续后台运行（例如按游戏自动切换扳机预设、状态栏显示与键鼠映射）。关闭主窗口后应用仍常驻菜单栏。"
          }
        }
      }
    },
    "Needs XInput mode.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa do modo XInput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处于 XInput 模式。"
          }
        }
      }
    },
    "Needs the USB cable (the receiver does not forward screen data).": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa do cabo USB (o receptor não encaminha os dados da tela)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接 USB 数据线（无线接收器不支持传输屏幕图像数据）。"
          }
        }
      }
    },
    "Never": {
