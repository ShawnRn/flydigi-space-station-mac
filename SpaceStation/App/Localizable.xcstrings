    "My game profiles": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus perfis de jogo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的游戏预设"
          }
        }
      }
    },
    "NS Slot %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NS 配置 %lld"
          }
        }
      }
