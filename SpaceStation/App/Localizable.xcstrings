    "Steam and Epic games run as their own app on the Mac; launch the game once, then pick it from Running apps.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos da Steam e Epic rodam como apps próprios no Mac; abra o jogo uma vez e escolha em Apps abertos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 和 Epic 游戏在 macOS 上会以独立进程运行；先启动一次游戏，即可从“正在运行的应用”中选取。"
          }
        }
      }
    },
    "Steps": {
      "localizations": {
